APP_NAME=OmPraMani
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FRONTEND_URL=http://localhost:3000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ompramani_db
DB_USERNAME=postgres
DB_PASSWORD=your_local_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@ompramani.vn"
MAIL_FROM_NAME="${APP_NAME}"

CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
SANCTUM_STATEFUL_DOMAINS="localhost:3000,127.0.0.1:3000"

# SePay Payment Gateway (Sandbox for local development)
SEPAY_ENVIRONMENT=sandbox
SEPAY_MERCHANT_ID=your_sandbox_merchant_id
SEPAY_MERCHANT_SECRET_KEY=your_sandbox_merchant_secret_key
SEPAY_IPN_SECRET_KEY=your_sandbox_ipn_secret_key
